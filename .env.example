# Master key for encrypting OAuth tokens at rest.
# Optional: the desktop app generates a per-install key at
# %LOCALAPPDATA%\second-brain\master.key if this is unset.
# BRAIN_MASTER_KEY=

# Google OAuth (Desktop / Web app with http://127.0.0.1:3456/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub fine-grained PAT (read-only: notifications, issues, PRs)
GITHUB_TOKEN=

# Ollama — local LLM + embeddings (default: http://127.0.0.1:11434)
# ollama pull qwen2.5:14b
# ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_FAST=gpt-oss:20b
OLLAMA_MODEL_SMART=gpt-oss:20b
# Falls back automatically if gpt-oss:20b is not pulled
OLLAMA_MODEL_FALLBACK=qwen2.5:14b
# Forever load: use -1 (sent as JSON number). Do not use the string "-1" —
# Ollama 0.32+ rejects it. Or use a Go duration like 24h / 30m.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_TOKENS=8192
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_MAX_TOKENS=4096

# Optional hosted OpenAI-compatible chat (Ask can use this; loops stay local)
# OpenAI:          https://api.openai.com/v1
# Groq:            https://api.groq.com/openai/v1
# OpenRouter:      https://openrouter.ai/api/v1
# BRAIN_HOSTED_LLM_URL=https://api.openai.com/v1
# BRAIN_HOSTED_LLM_KEY=
# BRAIN_HOSTED_LLM_MODEL=gpt-4o-mini
# Set to 1 to use the hosted model for Ask even when Ollama is healthy
# BRAIN_ASK_USE_HOSTED=1

# License signing secret (optional; defaults to BRAIN_MASTER_KEY)
# BRAIN_LICENSE_SECRET=

# Optional: override data directory (default: %LOCALAPPDATA%/second-brain)
# BRAIN_DATA_DIR=

# Capture retention (OCR text purged after N days)
# OCR_RETENTION_DAYS=30
# CAPTURE_IDLE_SECONDS=120

# Local API / UI
HOST=127.0.0.1
PORT=3000
WEB_PORT=5173
# TZ=America/New_York
